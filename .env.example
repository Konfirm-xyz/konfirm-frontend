# Copy to .env.local for local dev. In production (Vercel), set this
# directly in the project's environment variables instead of a checked-in
# file.

# Server-side only — read by next.config.ts's rewrites(), never exposed to
# the browser. Defaults to http://localhost:4001 if unset, so this is only
# required once the backend is deployed somewhere other than localhost.
BACKEND_URL=http://localhost:4001

# The canonical production origin, used for metadataBase / canonical / og:url
# so relative og:image paths resolve to absolute URLs. Set this to the real
# deployed domain in the Vercel project (e.g. https://konfirm.app).
NEXT_PUBLIC_SITE_URL=https://konfirm.app
